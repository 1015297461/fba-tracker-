# 运行时数据（数据库、用户配置等，见 data/ 目录）
/data/
*.tmp

# AI分析 skill 的登录态/Cookie 及诊断产物（敏感，不入库）
skills/*/data/
skills/*/report/

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# Node.js (Babel 编译输出)
node_modules/

# 单文件导出快照（按需用 export 功能重新生成）
export/
# 编译产物（npm run build 重新生成）
compiled/
