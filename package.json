{
  "name": "fba-tracker",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --outfile=compiled/bundle.js --minify --jsx=automatic --platform=browser",
    "watch": "esbuild src/main.tsx --bundle --outfile=compiled/bundle.js --watch --jsx=automatic --platform=browser",
    "prestart": "esbuild src/main.tsx --bundle --outfile=compiled/bundle.js --minify --jsx=automatic --platform=browser",
    "start": "python3 server.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
